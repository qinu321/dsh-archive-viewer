{
  "name": "dsh-archive-viewer",
  "version": "1.1.5",
  "description": "Read-only viewer for archived DSH sessions: browse the archive list and read a full transcript (including pre-compaction history) without unarchiving. | 归档会话只读查看器：不取消归档即可浏览归档列表、阅读完整对话与工具调用。",
  "author": "qinu321 (https://github.com/qinu321)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qinu321/dsh-archive-viewer.git"
  },
  "homepage": "https://github.com/qinu321/dsh-archive-viewer#readme",
  "bugs": {
    "url": "https://github.com/qinu321/dsh-archive-viewer/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "session",
    "archive",
    "viewer"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "type": "module",
  "main": "./host.js",
  "exports": {
    ".": "./host.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "host.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs",
    "assets"
  ],
  "engines": {
    "dsh": ">=0.2.0-rc.1"
  },
  "icon": "./icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "scripts": {
    "check": "node --check host.js && node --check client.js",
    "test": "node selftest.mjs && node client-selftest.mjs"
  }
}
